# Copy to `.env` and fill in. All variables are validated at startup by lib/env.ts.

# ---------------------------------------------------------------------------
# Database (required) — Postgres connection string used by the Prisma singleton.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/saas_dashboard?sslmode=disable"

# ---------------------------------------------------------------------------
# NextAuth v4 (required)
# ---------------------------------------------------------------------------
# Signs/verifies the session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Optional in local dev (auto-detected); set behind a proxy / in production.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Demo account (optional) — a shared sign-in for reviewers. Leave DEMO_PASSWORD
# empty to turn the demo sign-in off entirely; everyone then registers.
# DEMO_EMAIL should match the demo user in prisma/seed.ts (demo@saas-dashboard.dev)
# so a demo login resolves to a real, tenant-connected user.
# ---------------------------------------------------------------------------
DEMO_EMAIL="demo@saas-dashboard.dev"
DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# GitHub OAuth (optional) — set BOTH to enable the GitHub sign-in button.
# Register an OAuth app at https://github.com/settings/developers with callback:
#   http://localhost:3000/api/auth/callback/github
# ---------------------------------------------------------------------------
GITHUB_ID=""
GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Daily snapshot job (optional) — shared secret for GET /api/cron/snapshots,
# sent as `Authorization: Bearer <CRON_SECRET>`. On Vercel, set it on the
# project and Vercel Cron (vercel.json, daily at 00:10 UTC) sends the header
# itself. Without it the endpoint refuses every call.
# The value below works for local development only (at least 16 characters).
# For any deployed environment generate a real one:  openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET="dev-only-cron-secret-change-me"

# ---------------------------------------------------------------------------
# Email (optional) — confirmation emails, password reset, invite emails.
# With RESEND_API_KEY set, mail goes out through Resend (https://resend.com).
# MAIL_FROM must use a domain verified in Resend; its shared
# onboarding@resend.dev sender only delivers to your own Resend account email.
# Without a key, development writes each message as a JSON file to
# MAIL_DEV_DIR (default: <system temp>/meridian-mail) and logs it. A production
# deployment with neither sends no email: those features step aside.
# NEXTAUTH_URL is required in production when email is on (links use it).
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Meridian <onboarding@resend.dev>"
MAIL_DEV_DIR=""

# ---------------------------------------------------------------------------
# Stripe integration (optional) — Settings → Integrations stores each
# workspace's restricted key encrypted with ENCRYPTION_KEY (32 bytes, base64:
# openssl rand -base64 32). Without it a key is derived from NEXTAUTH_SECRET,
# which must then never change once Stripe is connected.
# STRIPE_API_BASE only changes for tests (scripts/fake-stripe.mjs).
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=""
# STRIPE_API_BASE="http://127.0.0.1:12111"
