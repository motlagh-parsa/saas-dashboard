# Copy to `.env` and fill in. All variables are validated at startup by lib/env.ts.

# ---------------------------------------------------------------------------
# Database (required) — Postgres connection string used by the Prisma singleton.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/saas_dashboard?sslmode=disable"

# ---------------------------------------------------------------------------
# NextAuth v4 (required)
# ---------------------------------------------------------------------------
# Signs/verifies the session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Optional in local dev (auto-detected); set behind a proxy / in production.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Demo account (required) — Credentials provider for reviewers without GitHub.
# DEMO_EMAIL should match the demo user in prisma/seed.ts (demo@saas-dashboard.dev)
# so a demo login resolves to a real, tenant-connected user.
# ---------------------------------------------------------------------------
DEMO_EMAIL="demo@saas-dashboard.dev"
DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# GitHub OAuth (optional) — set BOTH to enable the GitHub sign-in button.
# Register an OAuth app at https://github.com/settings/developers with callback:
#   http://localhost:3000/api/auth/callback/github
# ---------------------------------------------------------------------------
GITHUB_ID=""
GITHUB_SECRET=""