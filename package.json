{
  "name": "saas-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:metrics": "ts-node -r ./scripts/ts-runtime.cjs scripts/verify-metrics.ts",
    "snapshots:recompute": "ts-node -r ./scripts/ts-runtime.cjs scripts/recompute-snapshots.ts",
    "e2e:billing": "node scripts/e2e-billing.mjs",
    "e2e:onboarding": "node scripts/e2e-onboarding.mjs",
    "e2e:import": "node scripts/e2e-import.mjs",
    "e2e:api": "node scripts/e2e-api.mjs",
    "e2e:email": "node scripts/e2e-email.mjs",
    "e2e:notifications": "node scripts/e2e-notifications.mjs",
    "e2e:stripe": "node scripts/e2e-stripe.mjs",
    "fake:stripe": "node scripts/fake-stripe.mjs",
    "e2e:production": "node scripts/e2e-production.mjs"
  },
  "prisma": {
    "seed": "ts-node -r ./scripts/ts-runtime.cjs prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
