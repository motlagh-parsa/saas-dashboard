// SaaS Metrics Dashboard — Prisma schema
// Money is stored as integer minor units (cents). Never Float, never Decimal.
// Metrics are DERIVED from Subscription/Invoice rows and rolled up into MetricSnapshot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// scrypt hash from lib/password.ts (`scrypt$N$r$p$salt$hash`) — NEVER a
  /// plaintext password. NULL for users who only sign in through GitHub OAuth or
  /// the env-configured demo account.
  passwordHash  String?
  /// Set when an owner or admin suspends the account from /dashboard/users;
  /// NULL means active. Account-wide, not per workspace — see lib/user-actions.ts.
  suspendedAt   DateTime?
  /// SHA-256 (hex) of the one-time invite token — NEVER the token itself, which
  /// exists only in the link handed to the admin (lib/invite-token.ts). Set when
  /// an admin adds the account; cleared when the invite is accepted.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]
  /// Audit entries this user performed (the ACTOR side, never the target).
  auditLogs     AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  subscriptions Subscription[]
  invoices      Invoice[]
  snapshots     MetricSnapshot[]
  notifications Notification[]
  reportRuns    ReportRun[]
  auditLogs     AuditLog[]
}

model Membership {
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Billing — the source of truth every dashboard number derives from
//
// NOTE: `Subscription.amountCents >= 0` is enforced by a CHECK constraint added in
// migration 20260816121500_subscription_handoff_link_and_metric_indexes. Prisma has
// no schema syntax for CHECK constraints and does not track them for drift, so the
// migration is the only place it appears. A negative subscription price would break
// the NRR expansion/contraction identity and make Postgres `ROUND()` disagree with
// the seed's `Math.round()` on exact halves.
// ---------------------------------------------------------------------------

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  tier           PlanTier
  status         SubscriptionStatus @default(ACTIVE)
  amountCents    Int
  currency       String             @default("USD")
  interval       BillingInterval    @default(MONTHLY)
  startedAt      DateTime
  canceledAt     DateTime?
  endedAt        DateTime?

  /// Plan-change hand-off link: the segment this one CONTINUES.
  /// Set only when a segment supersedes another (upgrade/downgrade/renewal change);
  /// NULL for genuinely new or reactivated customers. `@unique` is load-bearing —
  /// it makes the hand-off graph a forest of simple paths (a segment has at most one
  /// predecessor via the column, and at most one successor via the unique index), so
  /// the NRR chain walk in lib/metrics.ts cannot fan out, fan in, or double-count.
  previousSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting an old segment must not delete the customer's
  // whole future lifecycle — it just breaks the link. Restrict would block the
  // Organization cascade delete above.
  previous     Subscription? @relation("SubscriptionHandoff", fields: [previousSubscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  next         Subscription? @relation("SubscriptionHandoff")
  invoices     Invoice[]

  // Live-as-of predicate (`startedAt <= t AND (endedAt IS NULL OR endedAt > t)`)
  // scoped to a tenant. Serves getMRR/mrrByCurrencyQuery, the NRR opening cohort,
  // and getActiveSubscriptions. Leading `organizationId` also covers the plain
  // tenant lookup and the Organization cascade-delete FK.
  @@index([organizationId, startedAt, endedAt])
  // "which of this tenant's segments ended in this window" — the hand-off/churn
  // direction, and the churn denominator's endedAt half.
  @@index([organizationId, endedAt])
  // churnQuery's numerator: canceledAt in (start, end], tenant-scoped.
  @@index([organizationId, canceledAt])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String
  amountCents    Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(PAID)
  issuedAt       DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, issuedAt])
  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Daily rollup — recomputed from the rows above, never hand-written.
// ARR = mrrCents * 12. Churn rate = churnedSubs / activeSubs at period start.
// Neither is stored: both are derived at read time.
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date

  mrrCents    Int
  activeSubs  Int
  newSubs     Int
  churnedSubs Int
  activeUsers Int
  newUsers    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

// ---------------------------------------------------------------------------
// Notification feed — operational events raised against a tenant.
//
// `userId = NULL` means the notification is ORG-WIDE (everyone in the workspace
// sees it); a set `userId` means it is PERSONAL to that member. Read state is a
// nullable timestamp rather than a boolean so "when was this read" survives —
// `readAt IS NULL` is the unread predicate everywhere.
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  /// Set when a member files the notification away. Archived rows leave the
  /// main feed, the unread count and the bell; they are listed only under the
  /// Archived tab. Independent of `readAt`: archiving never marks anything read.
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())

  // Cascade: a notification is meaningless without the tenant that raised it, and
  // the feed is derived operational data, not a record anyone audits after the
  // workspace is gone.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a member must not delete the org's event
  // history — the notification simply reverts to org-wide.
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The feed query: tenant-scoped, filtered on read and archived state, ordered
  // by createdAt desc. Serves getNotifications(), getUnreadCount() (the
  // organizationId+readAt+archivedAt prefix), and the Organization cascade-delete FK.
  @@index([organizationId, readAt, archivedAt, createdAt])
  // Per-member fan-out: "this user's unread items", and the User SetNull FK.
  @@index([userId, readAt])
}

enum NotificationType {
  MRR_MILESTONE
  INVOICE_PAID
  INVOICE_OVERDUE
  CHURN_ALERT
  MEMBER_JOINED
  REVENUE_DIP
  REPORT_READY
  SYSTEM
}

// ---------------------------------------------------------------------------
// Report runs — one row per "Generate" press on /dashboard/reports.
//
// `reportId` is a catalogue key (`REPORTS[].id` in report-catalogue.ts), not a
// foreign key: the catalogue is code, not a table. The route validates it against
// a closed list before anything is written.
// ---------------------------------------------------------------------------

model ReportRun {
  id             String   @id @default(cuid())
  organizationId String
  reportId       String
  generatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "latest run of this report for this tenant" — also covers the Organization
  // cascade-delete FK via the leading `organizationId`.
  @@index([organizationId, reportId, generatedAt])
}

// ---------------------------------------------------------------------------
// Audit log — who did what to what, per workspace. Written only through
// lib/audit-writer.ts, after a mutation has succeeded.
//
// The target is NOT a foreign key: `targetId` + `targetLabel` are a snapshot, so
// an entry about a user who was later deleted still says who they were. The
// actor IS a foreign key, SetNull on delete — the entry survives and reads as
// "a deleted user" rather than disappearing with its author.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  /// Dotted verb, e.g. "user.suspended" — the closed list is in lib/audit-view.ts.
  action         String
  targetType     String
  targetId       String?
  targetLabel    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The log query: one tenant, newest first. Also covers the Organization
  // cascade-delete FK via the leading `organizationId`.
  @@index([organizationId, createdAt])
  // The User SetNull FK — without it, deleting a user scans the whole log.
  @@index([actorId])
}

// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}