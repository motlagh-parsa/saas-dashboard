// SaaS Metrics Dashboard — Prisma schema
// Money is stored as integer minor units (cents). Never Float, never Decimal.
// Metrics are DERIVED from Subscription/Invoice rows and rolled up into MetricSnapshot.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// scrypt hash from lib/password.ts (`scrypt$N$r$p$salt$hash`) — NEVER a
  /// plaintext password. NULL for users who only sign in through GitHub OAuth or
  /// the env-configured demo account.
  passwordHash  String?
  /// Set when an owner or admin suspends the account from /dashboard/users;
  /// NULL means active. Account-wide, not per workspace — see lib/user-actions.ts.
  suspendedAt   DateTime?
  /// SHA-256 (hex) of the one-time invite token — NEVER the token itself, which
  /// exists only in the link handed to the admin (lib/invite-token.ts). Set when
  /// an admin adds the account; cleared when the invite is accepted.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  /// Sessions issued before this instant are refused (lib/auth.ts). Set by a
  /// password reset, so a reset also signs out every other device.
  sessionsRevokedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]
  /// Audit entries this user performed (the ACTOR side, never the target).
  auditLogs     AuditLog[]
  /// CSV imports this user started.
  importRuns    ImportRun[]
  /// API keys this user created.
  apiKeys       ApiKey[]
  /// Outstanding and used email verification / password reset tokens.
  emailTokens   EmailToken[]
  /// Overrides of the default notification channels (lib/notification-preferences.ts).
  notificationPreferences NotificationPreference[]
  /// Reports this user scheduled to be emailed to themselves.
  reportSchedules ReportSchedule[]
}

/// One user's choice for one notification type. Only overrides are stored; a
/// missing row means the default for the user's role (lib/notification-preferences.ts).
model NotificationPreference {
  userId    String
  type      NotificationType
  inApp     Boolean
  email     Boolean
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// A report emailed on a schedule to the user who set it up (lib/report-schedules.ts).
model ReportSchedule {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  reportId       String
  frequency      ReportFrequency
  /// The next time the daily job should send it. Advanced after each send.
  nextRunAt      DateTime
  lastSentAt     DateTime?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The daily job: "which schedules are due".
  @@index([nextRunAt])
  // The Reports page list, and the Organization cascade-delete FK.
  @@index([organizationId, userId])
  // The User cascade-delete FK.
  @@index([userId])
  // One schedule per report per person per workspace.
  @@unique([organizationId, userId, reportId])
}

/// "This was already alerted" — the alert engine (lib/alerts.ts) records one
/// mark per thing it has told the workspace about (a churned customer, an
/// overdue invoice, a milestone), so each is said once.
model AlertMark {
  organizationId String
  key            String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

/// One-time tokens sent by email (lib/email-tokens.ts). Only the SHA-256 of the
/// token is stored; the token itself exists only in the emailed link.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  /// SHA-256 hex of the token — never the token.
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rate limiting ("how many sent in the last hour") and invalidating a user's
  // other tokens of one purpose. Also covers the User cascade-delete FK.
  @@index([userId, purpose, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A founder's WORKSPACE — the tenant. It is never the customer: the people who
/// pay this founder are `Customer` rows inside it.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// ISO 4217 code — the workspace's single reporting currency. Every amount in
  /// the workspace (plans, subscriptions, invoices, snapshots) is in it, which is
  /// why none of those rows carries a currency of its own.
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  customers     Customer[]
  plans         Plan[]
  subscriptions Subscription[]
  invoices      Invoice[]
  snapshots     MetricSnapshot[]
  notifications Notification[]
  reportRuns    ReportRun[]
  auditLogs     AuditLog[]
  importRuns    ImportRun[]
  apiKeys       ApiKey[]
  reportSchedules ReportSchedule[]
  alertMarks      AlertMark[]
}

model Membership {
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Billing — the source of truth every dashboard number derives from.
//
// A workspace (Organization) is the TENANT. Everything below belongs to one
// workspace and describes that founder's business: their Customers, the Plans
// they sell, the Subscriptions and Invoices between the two. All amounts are
// integer minor units in the workspace's `Organization.currency`.
//
// Every row that can arrive from outside carries `source` and an optional
// `externalId`, unique per workspace, so a CSV re-import or a Stripe re-sync
// updates the row it already wrote instead of duplicating it.
//
// CHECK constraints (Prisma has no schema syntax for them and does not track
// them for drift, so the migrations are the only place they appear):
//   - Subscription.amountCents >= 0 (20260816121500_…) and Plan.amountCents >= 0
//     — a negative price would break the expansion/contraction identity.
//   - Subscription.quantity >= 1, Subscription.intervalCount >= 1 and
//     Plan.intervalCount >= 1 — MRR divides by the interval length, and a
//     zero-quantity row would be a subscription that bills nothing forever.
// ---------------------------------------------------------------------------

/// Where a row came from. SAMPLE rows are generated demo data
/// (lib/sample-data.ts) and are the only rows `removeSampleData` touches.
enum DataSource {
  MANUAL
  CSV
  API
  STRIPE
  SAMPLE
}

/// One of the founder's paying customers. A customer has many subscriptions
/// over time; "active" is derived (a live subscription with MRR > 0), never stored.
model Customer {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  email          String?
  externalId     String?
  source         DataSource @default(MANUAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  /// Hidden from pickers and lists; history (and therefore every metric) is kept.
  archivedAt     DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, externalId])
  // The customer list and pickers: one tenant, alphabetical. Leading
  // `organizationId` also covers the Organization cascade-delete FK.
  @@index([organizationId, name])
}

/// A price the founder sells at. A subscription COPIES the plan's amount and
/// interval when it starts, so repricing a plan never rewrites history.
model Plan {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  /// Price per unit per interval.
  amountCents    Int
  interval       BillingInterval
  /// Stripe-style: quarterly is MONTH with intervalCount 3.
  intervalCount  Int             @default(1)
  externalId     String?
  source         DataSource      @default(MANUAL)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([organizationId, externalId])
  // Also serves the plan pickers and the Organization cascade-delete FK.
  @@unique([organizationId, name])
}

/// One lifecycle SEGMENT of a customer's subscription: a single price, quantity
/// and interval for a span of time. A plan change ends one segment and starts
/// another on the same instant.
model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String
  /// Null for a custom-priced subscription; also nulled if its plan is deleted.
  planId         String?
  status         SubscriptionStatus @default(ACTIVE)
  /// Price per unit per interval, copied from the plan when the segment started.
  amountCents    Int
  quantity       Int                @default(1)
  interval       BillingInterval    @default(MONTH)
  intervalCount  Int                @default(1)
  startedAt      DateTime
  /// Set only for a real cancellation — a segment superseded by a plan change
  /// has `endedAt` but no `canceledAt`.
  canceledAt     DateTime?
  endedAt        DateTime?

  /// Plan-change hand-off link: the segment this one CONTINUES. Records what
  /// happened; metrics do NOT depend on it — `customerId` says who is who.
  previousSubscriptionId String? @unique

  externalId String?
  source     DataSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: deleting an old segment must not delete the customer's
  // whole future lifecycle — it just breaks the link.
  previous     Subscription? @relation("SubscriptionHandoff", fields: [previousSubscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  next         Subscription? @relation("SubscriptionHandoff")
  invoices     Invoice[]

  @@unique([organizationId, externalId])
  // Live-as-of predicate (`startedAt <= t AND (endedAt IS NULL OR endedAt > t)`)
  // scoped to a tenant: MRR, the retention cohorts, plan mix. Leading
  // `organizationId` also covers the Organization cascade-delete FK.
  @@index([organizationId, startedAt, endedAt])
  // "which of this tenant's segments ended in this window" — the churn side.
  @@index([organizationId, endedAt])
  // One customer's history within a tenant: the customer list, per-customer MRR.
  @@index([organizationId, customerId])
  // The Customer cascade-delete FK and the Plan SetNull FK: without these,
  // deleting one customer or plan scans every subscription.
  @@index([customerId])
  @@index([planId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  /// Null for a one-off charge.
  subscriptionId String?
  amountCents    Int
  status         InvoiceStatus @default(PAID)
  issuedAt       DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  externalId     String?
  source         DataSource    @default(MANUAL)
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, issuedAt])
  @@index([subscriptionId])
  // The Customer cascade-delete FK.
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Daily rollup — recomputed from the rows above, never hand-written
// (lib/snapshot-formula.ts). A row for day D holds the STATE at D's UTC midnight
// and the FLOWS in (D − 1 day, D]. ARR (= MRR × 12) and churn rates are derived
// at read time, not stored.
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date

  mrrCents         Int
  activeSubs       Int
  newSubs          Int
  churnedSubs      Int
  /// Customers with at least one live subscription with MRR > 0.
  activeCustomers  Int
  /// Active now, not active the day before, and never active before.
  newCustomers     Int
  /// Active the day before, not active now.
  churnedCustomers Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

// ---------------------------------------------------------------------------
// Notification feed — operational events raised against a tenant.
//
// `userId = NULL` means the notification is ORG-WIDE (everyone in the workspace
// sees it); a set `userId` means it is PERSONAL to that member. Read state is a
// nullable timestamp rather than a boolean so "when was this read" survives —
// `readAt IS NULL` is the unread predicate everywhere.
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  /// Set when a member files the notification away. Archived rows leave the
  /// main feed, the unread count and the bell; they are listed only under the
  /// Archived tab. Independent of `readAt`: archiving never marks anything read.
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())

  // Cascade: a notification is meaningless without the tenant that raised it, and
  // the feed is derived operational data, not a record anyone audits after the
  // workspace is gone.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a member must not delete the org's event
  // history — the notification simply reverts to org-wide.
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The feed query: tenant-scoped, filtered on read and archived state, ordered
  // by createdAt desc. Serves getNotifications(), getUnreadCount() (the
  // organizationId+readAt+archivedAt prefix), and the Organization cascade-delete FK.
  @@index([organizationId, readAt, archivedAt, createdAt])
  // Per-member fan-out: "this user's unread items", and the User SetNull FK.
  @@index([userId, readAt])
}

enum NotificationType {
  MRR_MILESTONE
  INVOICE_PAID
  INVOICE_OVERDUE
  CHURN_ALERT
  MEMBER_JOINED
  REVENUE_DIP
  REPORT_READY
  IMPORT_FINISHED
  SYSTEM
  WEEKLY_SUMMARY
}

enum ReportFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

// ---------------------------------------------------------------------------
// Report runs — one row per "Generate" press on /dashboard/reports.
//
// `reportId` is a catalogue key (`REPORTS[].id` in report-catalogue.ts), not a
// foreign key: the catalogue is code, not a table. The route validates it against
// a closed list before anything is written.
// ---------------------------------------------------------------------------

model ReportRun {
  id             String   @id @default(cuid())
  organizationId String
  reportId       String
  generatedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "latest run of this report for this tenant" — also covers the Organization
  // cascade-delete FK via the leading `organizationId`.
  @@index([organizationId, reportId, generatedAt])
}

// ---------------------------------------------------------------------------
// CSV imports — one row per import a founder ran from /dashboard/import.
//
// The uploaded file itself is never stored. What is kept is what a founder needs
// afterwards: the counts, and the first 1,000 row errors WITH the original row
// values, so the error report can be downloaded again from the history.
//
// A run that fails part-way stays FAILED with the counts of what WAS written:
// imports commit in chunks, and chunks already committed stay committed.
// ---------------------------------------------------------------------------

enum ImportKind {
  CUSTOMERS
  PLANS
  SUBSCRIPTIONS
  INVOICES
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
}

model ImportRun {
  id             String       @id @default(cuid())
  organizationId String
  kind           ImportKind
  fileName       String
  status         ImportStatus @default(RUNNING)
  /// Data rows in the file (header excluded).
  totalRows      Int
  created        Int          @default(0)
  updated        Int          @default(0)
  unchanged      Int          @default(0)
  errorCount     Int          @default(0)
  /// { headers: string[], rows: { line, values: string[], message }[] } — the
  /// first 1,000 row errors, for the downloadable error report.
  errors         Json?
  startedById    String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull: deleting the person who ran an import must not erase its record.
  startedBy    User?        @relation(fields: [startedById], references: [id], onDelete: SetNull)

  // The history list: one tenant, newest first. Also covers the Organization
  // cascade-delete FK via the leading `organizationId`.
  @@index([organizationId, startedAt])
  // The User SetNull FK.
  @@index([startedById])
}

// ---------------------------------------------------------------------------
// Audit log — who did what to what, per workspace. Written only through
// lib/audit-writer.ts, after a mutation has succeeded.
//
// The target is NOT a foreign key: `targetId` + `targetLabel` are a snapshot, so
// an entry about a user who was later deleted still says who they were. The
// actor IS a foreign key, SetNull on delete — the entry survives and reads as
// "a deleted user" rather than disappearing with its author.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  /// Set for writes made through the REST API: the key that made them. Such
  /// entries have no actorId — a key acts for the workspace, not for a person.
  apiKeyId       String?
  /// Dotted verb, e.g. "user.suspended" — the closed list is in lib/audit-view.ts.
  action         String
  targetType     String
  targetId       String?
  targetLabel    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // SetNull: a deleted key's entries stay, reading as "a deleted API key".
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  // The log query: one tenant, newest first. Also covers the Organization
  // cascade-delete FK via the leading `organizationId`.
  @@index([organizationId, createdAt])
  // The User SetNull FK — without it, deleting a user scans the whole log.
  @@index([actorId])
  // The ApiKey SetNull FK.
  @@index([apiKeyId])
}

// ---------------------------------------------------------------------------
// REST API keys and rate limiting (app/api/v1, lib/api).
//
// A key belongs to one workspace, and the workspace of every API request comes
// from its key — never from the request. Only the SHA-256 of a key is stored;
// the key itself is shown once, when it is created. `prefix` (its first 12
// characters, "mrd_" and 8 more) is what the UI shows to tell keys apart.
// ---------------------------------------------------------------------------

enum ApiScope {
  /// Read endpoints only.
  READ
  /// Read and write.
  WRITE
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  /// SHA-256 hex of the full key — the only form of it that is stored.
  keyHash        String    @unique
  scope          ApiScope
  createdById    String?
  createdAt      DateTime  @default(now())
  /// Touched at most once a minute, not on every request.
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]
  rateLimits   ApiRateLimit[]

  // The Settings list, and counting a workspace's active keys. Also covers the
  // Organization cascade-delete FK.
  @@index([organizationId, revokedAt])
  // The User SetNull FK.
  @@index([createdById])
}

/// Requests per key per one-minute window. In Postgres, not in memory: on
/// serverless every request may land on a different instance. Incremented with
/// one atomic upsert; old windows are pruned as new ones open.
model ApiRateLimit {
  keyId       String
  windowStart DateTime
  count       Int      @default(0)

  key ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, windowStart])
}

// ---------------------------------------------------------------------------

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}